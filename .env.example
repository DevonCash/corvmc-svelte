# Drizzle
# Replace with your DB credentials!
DATABASE_URL="postgres://user:password@host:port/db-name"

ORIGIN=""

# Canonical site URL. Also determines the base domain for band-site subdomain
# routing ({slug}.<domain> → /band-site/{slug}); defaults to corvmc.org when unset.
PUBLIC_SITE_URL=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Cloudflare Turnstile (bot protection on public sign-up, contact, subscribe forms)
# Leave blank locally to use Cloudflare's always-pass test keys.
PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Postmark (transactional email). In production this is a Worker secret; it is
# also required in the shell for `pnpm email:push` / `pnpm email:pull`, which
# sync postmark/templates/ with the Postmark server this token belongs to.
POSTMARK_SERVER_TOKEN=""

# Cloudflare R2 (S3-compatible object storage)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""
# Optional: Cloudflare Image Transformations URL for on-the-fly resize/webp
# R2_TRANSFORM_URL=""
